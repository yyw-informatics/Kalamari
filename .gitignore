/Kalamari2_v*/

# ---- curation-triage: per-run output, regenerated on every run ----
# tier1_metadata.py / collate.py write these. CI writes them at the repo root
# and uploads them as expiring build artifacts; it never commits them.
/worklist.tsv
/worklist.md
src/curation-triage/worklist.tsv
src/curation-triage/worklist.md
# sharded lead fragments (--emit-leads / --leads-dir)
leads.*.ndjson
/run/
/frags/
src/curation-triage/worklist_tier2.tsv
src/curation-triage/worklist_tier2.md

# ---- Tier 2: downloaded genome FASTA (never committed) ----
# Tier 2 is the first tier that needs sequence. A genome is megabytes per
# accession, so only the DERIVED results are committed (tier2_ani_cache.json,
# tier2_typer_cache.json); the FASTA cache itself is local scratch.
/.cache/

# Belt and braces for the same rule. The line above only covers the default
# cache location, but --genome-cache takes any path, and a run pointed inside
# the repo would leave committable sequence behind. These patterns say "no
# sequence, anywhere", so the rule holds wherever a run happens to write.
# Nothing tracked matches them (checked); *.gz is deliberately NOT listed,
# because src/provenance/ ships two committed .gz tables.
*.fna
*.fa
*.fasta
*.fsa
*.fna.gz
*.fasta.gz

# Frozen-database and bundle archives. The docs tell maintainers to keep copies
# of amrfinderplus-db-2026-05-15.1.tar.gz (44 MB), so a copy landing in the repo
# is a plausible accident rather than a hypothetical one.
*.tar.gz
*.tgz
*.tar
*.zip

# ---- DELIBERATELY COMMITTED - do not add ignore rules for these ----
# The monthly workflow runs `tier1_metadata.py --offline` with no network, and
# the golden tests rebuild the policy table from cache. These files are inputs,
# not throwaway output. Ignoring any of them breaks CI:
#   src/curation-triage/assembly_reports_cache.json  J1a offline cache (CI)
#   src/curation-triage/nuccore_cache.json           Tier-0 offline cache
#   src/curation-triage/taxon_policy.tsv             CI input + golden test
#   src/curation-triage/confounded_manifest.tsv      hand-authored input
#   src/curation-triage/ledger.ndjson                delta baseline; CI commits it
#   src/curation-triage/reviews.tsv                  SME decisions (human-edited)
#   src/curation-triage/coverage_report.tsv          coverage measurement (doc-linked)
#   src/curation-triage/lpsn_cache.json              J2 LPSN offline cache (CI)
#   src/curation-triage/amrfinderplus_db_manifest.tsv  the frozen AMRFinder database's digests

# ---- machine-local configuration (never committed) ----
# One NCBI taxdump directory per line, read by bin/curation-triage/taxonomy.py.
# It is local on purpose: an absolute path in the repository would publish one
# institution's filesystem layout and would be wrong on every other machine.
/.taxdump-search

